# CertiChain client configuration
# Copy to `.env` (git-ignored) and adjust as needed.
# Only VITE_* variables are exposed to the browser bundle.

# ---- Read-only RPC endpoints (no secrets — used by the verify flow) ----
# Sepolia public RPC (default: keyless PublicNode endpoint)
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Local Hardhat node for development
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545

# ---- Block explorer ----
VITE_SEPOLIA_EXPLORER=https://sepolia.etherscan.io

# ---- Pre-deployed contract address overrides (optional) ----
# Normally these come from the generated `src/contract/deployments.registry.json`
# (written by `npm run sync:registry:local` / `sync:registry:sepolia`).
# Set these to override without re-syncing, e.g. for a CI build:
# VITE_REGISTRY_ADDRESS_SEPOLIA=0x...
# VITE_REGISTRY_ADDRESS_LOCAL=0x...

# NOTE: The client NEVER holds private keys. All writes are signed by the
# user's browser wallet (MetaMask / any EIP-1193 provider). Never put a
# private key or API secret in a VITE_* variable — it would be bundled
# into the public JS.
