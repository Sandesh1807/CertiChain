# CertiChain contracts environment template.
# Copy this file to `.env` (gitignored) and fill in your values. NEVER commit `.env`.

# Wallet private key funded with Sepolia ETH (deployer / owner).
# Use a BURNER wallet only — never export a key from a wallet holding real funds.
# REQUIRED for `npm run deploy:registry:sepolia`.
SEPOLIA_PRIVATE_KEY=

# Optional: a private RPC endpoint (Alchemy/Infura free tier) for more
# reliable Sepolia access. Defaults to the free keyless PublicNode RPC.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: free Etherscan API key for automatic source-code verification.
ETHERSCAN_API_KEY=
